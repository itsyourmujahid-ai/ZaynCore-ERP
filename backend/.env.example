# Enterprise ERP Backend Environment Configuration Template
NODE_ENV=development
PORT=3000

# Database Connection (Supabase PostgreSQL / Self-Hosted PostgreSQL)
# Example Supabase Session Pooler (IPv4 compatible):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_erp

# Authentication / Security
JWT_SECRET=replace-with-a-secure-random-32-character-secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173